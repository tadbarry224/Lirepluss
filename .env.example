# Copier ce fichier en .env.local puis renseigner les valeurs.
# Sans configuration, l'application fonctionne en MODE DÉMO (données locales dans le navigateur).

# --- IA (optionnel) : https://console.anthropic.com ---
# Sans clé, les recommandations et parcours utilisent l'algorithme local.
ANTHROPIC_API_KEY=

# --- Supabase (multi-utilisateurs) : https://supabase.com ---
# Project Settings → API : "Project URL" et clé "publishable" (ou "anon public").
# Ces deux valeurs sont publiques par nature : la sécurité repose sur les règles RLS de supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_KEY=
